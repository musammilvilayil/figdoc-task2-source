PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Optional server-side fallback. Prefer entering a token per request in the UI.
FIGMA_ACCESS_TOKEN=
# Optional Google OAuth. Register this callback URL in Google Cloud Console:
# http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# SMTP settings for optional email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Extra hourly cap for login, registration, document preparation, and downloads.
# Zero keeps this future notification policy disabled for now.
NOTIFICATION_LIMIT=0
